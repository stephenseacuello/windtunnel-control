# regenerable
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.DS_Store

# Instrument scratch. logs/ IS committed — it holds the experimental record
# (the gust runs that measured tau, and the reference blade sweep). What is
# excluded is bulk that would swamp the history.
logs/*_points.csv.gz
logs/archive/
*.bak
data/tunnel.json.bak

# Snapshots are records worth committing — but not the smoke-test ones.
data/snapshots/*_dashboard.json

# Parameter snapshots taken in dry-run. A simulated drive answers EVERY
# register plausibly, so one of these looks exactly like a real capture and
# has been mistaken for one before — see data/snapshots/simulated/README.md.
# Anything genuinely worth keeping goes in data/snapshots/simulated/ on
# purpose, not by accident.
data/snapshots/*SIMULATED*.json
