// Air at 20 C and 101.325 kPa (reports/roughness_2026-09/src/data.py:
// RHO_STD, NU_STD). Kinematic: OpenFOAM's incompressible solvers work in p/rho.
rhoInf          1.204;       // kg/m^3, used by forces/forceCoeffs
nu              1.516e-5;    // m^2/s

// Stage 1 free-stream speeds (cfd/PLAN.md), m/s. A case sets UInf to one of them.
UInfLow         10;
UInfMid         23;
UInfHigh        38;

