/*--------------------------------*- C++ -*----------------------------------*\
  Stage 2 section case (cfd/stage2; copied from cfd/section2d). Numbers come from
  system/caseParameters, which cfd/stage2/run_case.py writes for each case.
  LOW-RE version (wall tex); run_case.py copies it over 0/nut. As Stage 1.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../system/caseParameters"

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform $nutInlet;

boundaryField
{
    farfield
    {
        type            calculated;
        value           uniform $nutInlet;
    }
    blade
    {
        // low-Re treatment: nut = 0 at the wall (first cell y+ < 1; the texture is meshed)
        type            nutLowReWallFunction;
        value           uniform 0;
    }
    bladeEnds
    {
        $blade;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
