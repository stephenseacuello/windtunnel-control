/*--------------------------------*- C++ -*----------------------------------*\
  Stage 2 section case (cfd/stage2; copied from cfd/section2d). Numbers come from
  system/caseParameters, which cfd/stage2/run_case.py writes for each case.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../system/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($Ux $Uy 0);

boundaryField
{
    farfield
    {
        // inflow where the flux enters, zero gradient where it leaves
        type            freestreamVelocity;
        freestreamValue uniform ($Ux $Uy 0);
        value           uniform ($Ux $Uy 0);
    }
    blade
    {
        type            noSlip;
    }
    bladeEnds
    {
        $blade;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
