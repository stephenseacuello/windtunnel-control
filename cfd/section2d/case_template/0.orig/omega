/*--------------------------------*- C++ -*----------------------------------*\
  Stage 1 section case (cfd/section2d). Numbers come from system/caseParameters,
  which cfd/section2d/run_case.py writes for each case.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../system/caseParameters"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform $omegaInlet;
        value           uniform $omegaInlet;
    }
    blade
    {
        // blends to the viscous-sublayer value 6 nu/(beta1 y^2) at y+ < 1 (as T3A)
        type            omegaWallFunction;
        value           uniform $omegaInlet;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
