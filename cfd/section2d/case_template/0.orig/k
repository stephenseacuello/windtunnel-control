/*--------------------------------*- C++ -*----------------------------------*\
  Stage 1 section case (cfd/section2d). Numbers come from system/caseParameters,
  which cfd/section2d/run_case.py writes for each case.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../system/caseParameters"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform $kInlet;
        value           uniform $kInlet;
    }
    blade
    {
        // low-Re wall: first cell centre at y+ < 1, k = 0 at the wall (as T3A)
        type            fixedValue;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
